# REQUIRED VARIABLES (Must be set)

# Django Secret Key (CHANGE IN PRODUCTION!)
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration (Required)
DB_NAME=songlist_db
DB_USER=postgres
DB_PASSWORD=your_secure_password


# Django Settings
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Optional - defaults shown)
DB_HOST=localhost
DB_PORT=5432

# Redis Cache
REDIS_URL=redis://127.0.0.1:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TIMEZONE=Asia/Kolkata
CELERY_TASK_TIME_LIMIT=1800

# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@songlist.com

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=your_live_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:8000

# JWT Token Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=2
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# Static and Media URLs
STATIC_URL=static/
MEDIA_URL=/media/

# Celery Beat Schedule Configuration
CELERY_POLL_PAYMENTS_INTERVAL_MINUTES=10
CELERY_CLEANUP_WEBHOOKS_HOUR=3
CELERY_CLEANUP_WEBHOOKS_MINUTE=0
CELERY_CLEANUP_TOKENS_HOUR=2
CELERY_CLEANUP_TOKENS_MINUTE=0
CELERY_TASK_EXPIRES_SECONDS=3600

# Rate Limiting
RATE_LIMIT_ENABLE=1
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW=60

# Internationalization
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Kolkata

